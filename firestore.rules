rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Logged in, email verified, and an ALU email
    function verifiedAlu() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(alustudent|alueducation)[.]com$');
    }

    function isStaff() {
      return verifiedAlu()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /users/{uid} {
      // You can read your own profile; staff can read all
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // On registration you can only create YOUR profile, and only as a student
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student';

      // You can edit your profile, but never change your own role
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if verifiedAlu();

      // Students report as themselves, always starting as "submitted"
      allow create: if verifiedAlu()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category in
           ['Water', 'Electricity', 'Facilities', 'Furniture', 'Sanitation', 'Safety', 'Other']
        && request.resource.data.priority in ['Low', 'Medium', 'High'];

      // Only staff can update, and only the status-related fields
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'staffNote', 'updatedAt', 'history'])
        && request.resource.data.status in ['submitted', 'in_progress', 'resolved', 'rejected'];

      // Staff can delete any report; students only their own, while still "submitted"
      allow delete: if isStaff()
        || (verifiedAlu()
            && resource.data.reportedBy == request.auth.uid
            && resource.data.status == 'submitted');
    }
  }
}